# وضع التشغيل: real يربط بباك اند حقيقي، mock يستخدم بيانات وهمية
# محلية بلا أي باك اند فعلي (مفيد للتطوير بلا سيرفر شغّال)
VITE_API_MODE=real

# رابط الباك اند:
# - تطوير محلي: http://127.0.0.1:8000/api (الباك اند شغّال على نفس
#   الجهاز عبر php artisan serve)
# - إنتاج (بعد النشر على Vercel): يجب استبداله برابط الباك اند
#   المستضاف الحقيقي (مثلًا https://your-backend.railway.app/api)
#   عبر Environment Variables بإعدادات مشروع Vercel نفسه، وليس هنا —
#   هذا الملف مرجعي بس، القيمة الفعلية وقت البناء تُقرأ من إعدادات
#   الاستضافة.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
